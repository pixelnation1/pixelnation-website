# Supabase — PixelNation Communities
# Create a project at https://supabase.com/dashboard and paste the values locally.
# Do not commit real keys. .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional absolute site origin used when building magic-link redirect URLs
# in production (defaults to the request origin / forwarded host).
# Example: https://www.pixelnation.co
NEXT_PUBLIC_SITE_URL=

# Supabase Dashboard (Auth) — configure manually:
# 1. Authentication → Providers → Email: enable Email, disable password if desired.
# 2. Authentication → URL Configuration:
#    Site URL: https://www.pixelnation.co (local: http://localhost:3000)
#    Redirect URLs allow list:
#      http://localhost:3000/auth/callback
#      https://www.pixelnation.co/auth/callback
#      https://pixelnation.co/auth/callback
# 3. Apply supabase/migrations/20260925_pixelnation_communities.sql if not already applied.

# ---------------------------------------------------------------------------
# Square — in-store purchase Support Points (server-only; never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Access token from Square Developer Dashboard → Applications → your app.
SQUARE_ACCESS_TOKEN=
# PixelNation store location id (Orders/Payments filter).
SQUARE_LOCATION_ID=
# Webhook subscription signature key (NOT the access token).
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Exact notification URL registered on the webhook subscription.
# Production: https://www.pixelnation.co/api/square/webhook
SQUARE_WEBHOOK_NOTIFICATION_URL=
# sandbox | production — defaults to production when unset.
SQUARE_ENVIRONMENT=
# MUST stay off until ready. Unset/false/empty → no support_point_entries inserts.
# Set to true only after mappings + webhook subscription are verified.
SQUARE_SUPPORT_POINTS_ENABLED=
